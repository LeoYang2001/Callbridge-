{
  "name": "callbridge",
  "private": true,
  "version": "0.1.0",
  "description": "Multilingual AI phone assistant — web MVP (Phase 0)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "laptop": "node scripts/laptop.mjs",
    "twilio:setup": "node scripts/twilio-setup.mjs",
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm run test -w server",
    "usage": "node scripts/usage-report.mjs",
    "service:install": "sh scripts/mac-service.sh install",
    "service:uninstall": "sh scripts/mac-service.sh uninstall",
    "service:restart": "sh scripts/mac-service.sh restart",
    "service:status": "sh scripts/mac-service.sh status",
    "service:logs": "sh scripts/mac-service.sh logs"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "qrcode-terminal": "^0.12.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
