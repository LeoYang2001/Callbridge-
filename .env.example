# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Public HTTPS URL that Twilio can reach: your Cloudflare Tunnel hostname (or an ngrok URL).
# No trailing slash.
PUBLIC_BASE_URL=https://callbridge.byte2bite.tech
# Name of a Cloudflare named tunnel routed to PUBLIC_BASE_URL. When set, `npm run laptop` runs it
# instead of a quick tunnel, so the address never changes. Empty: a random trycloudflare.com URL.
CLOUDFLARE_TUNNEL=callbridge
# ── Accounts (sign-in with a phone number) ─────────────────────────────────
# Only these numbers can create an account (invite-only). Empty: anyone with the link can sign up
# and place calls on your Twilio and OpenAI accounts.
SIGNUP_ALLOWLIST=+14155550123
# Sign-in codes: "verify" texts them with Twilio Verify (needs the service SID, about $0.05 each);
# "log" prints them in the server log, for testing on your own laptop only.
AUTH_CODES=log
TWILIO_VERIFY_SERVICE_SID=
# Users, profiles, sessions, and call history.
DATABASE_FILE=data/callbridge.db
# Extra browser origins allowed to call the API (your hosted app). Always allowed:
# https://*.github.io, https://*.pages.dev and localhost.
CORS_ORIGINS=https://callbridge.byte2bite.tech

# ── Twilio (telephony) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# A voice-capable Twilio number you own, E.164.
TWILIO_FROM_NUMBER=+15555550100
TWILIO_VALIDATE_SIGNATURES=true
# Calling from the mobile app (Twilio Voice SDK): an API key and a TwiML App whose voice URL is
# <PUBLIC_BASE_URL>/twilio/client-voice. Empty: the server rings the user's phone instead.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# ── OpenAI (live translation) ──────────────────────────────────────────────
# The account needs access to gpt-realtime-translate.
OPENAI_API_KEY=
TRANSLATE_MODEL=gpt-realtime-translate
# Captions of what each person said, in their own language.
TRANSCRIPTION_MODEL=gpt-4o-transcribe
# The interpreter's spoken notices ("an AI interpreter has joined", Ask for me).
ANNOUNCE_TTS_MODEL=gpt-4o-mini-tts
ANNOUNCE_VOICE=marin

# ── Guardrails ─────────────────────────────────────────────────────────────
# Strongly recommended while testing: only these numbers can be dialed.
ALLOWED_DESTINATIONS=+14155550123
MAX_CALL_SECONDS=600
MAX_CALLS_PER_HOUR=10

# ── Debugging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
