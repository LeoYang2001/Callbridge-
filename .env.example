# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Public HTTPS URL that Twilio can reach (e.g. `ngrok http 3000`). No trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.ngrok.app
# Required whenever the server is reachable from the internet. Enter the same value as the
# "Access key" in the app's Settings (or as the basic-auth password, any username).
APP_PASSWORD=
# Browser origins allowed to call the API (the hosted UI). Default: any https://*.github.io + localhost.
CORS_ORIGINS=

# ── Twilio (telephony) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# A voice-capable Twilio number you own, E.164.
TWILIO_FROM_NUMBER=+15555550100
TWILIO_VALIDATE_SIGNATURES=true

# ── OpenAI (voice AI + post-call analysis) ──────────────────────────────────
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_REASONING_EFFORT=low
# semantic_vad waits for the speaker to finish a thought; server_vad is purely silence based.
REALTIME_TURN_DETECTION=semantic_vad
TRANSCRIPTION_MODEL=gpt-4o-transcribe
ANALYSIS_MODEL=gpt-5.4-mini

# ── Guardrails ─────────────────────────────────────────────────────────────
# Strongly recommended while testing: only these numbers can be dialed.
ALLOWED_DESTINATIONS=+14155550123
MAX_CALL_SECONDS=600
MAX_CALLS_PER_HOUR=10
INTRO_DELAY_MS=2500

# ── Debugging ──────────────────────────────────────────────────────────────
# Saves finished call records (including transcripts) to ./data/calls.
PERSIST_CALLS=true
LOG_LEVEL=info
