{
  "expo": {
    "name": "CallBridge",
    "slug": "callbridge",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "callbridge",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "tech.byte2bite.callbridge",
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "CallBridge uses the microphone for your calls when you call from the app.",
        "NSPhotoLibraryUsageDescription": "CallBridge doesn't use your photos. This is required by a system library the app includes."
      },
      "bitcode": false
    },
    "android": {
      "package": "tech.byte2bite.callbridge",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "CallBridge lets you pick someone from your contacts to call. It only reads the person you pick."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "@twilio/voice-react-native-sdk",
        {
          "microphoneUsageDescription": "CallBridge uses the microphone for your calls when you call from the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3dd3fe7-4335-4d0d-96ab-13b7c59a19b5"
      }
    },
    "owner": "leoyang_202207",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a3dd3fe7-4335-4d0d-96ab-13b7c59a19b5",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
