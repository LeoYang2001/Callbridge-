{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.20.2",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://callbridge.byte2bite.tech"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "testflight"
    },
    "development-device": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "bundleIdentifier": "tech.byte2bite.callbridge",
        "ascAppId": "6820610012"
      }
    }
  }
}
